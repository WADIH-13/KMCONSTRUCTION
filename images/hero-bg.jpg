<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#95a5a6" stroke-width="0.5" opacity="0.2"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="#34495e"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>
  <rect x="0" y="0" width="100%" height="100%" fill="#D35400" opacity="0.1"/>
  <text x="50%" y="50%" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#ecf0f1" text-anchor="middle" dominant-baseline="middle">
    🏗️ CHANTIER DE CONSTRUCTION
  </text>
  <text x="50%" y="60%" font-family="Arial, sans-serif" font-size="14" fill="#95a5a6" text-anchor="middle" dominant-baseline="middle">
    1920x1080 - À remplacer par une vraie photo
  </text>
</svg>